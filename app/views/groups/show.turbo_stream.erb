<%= turbo_stream.replace "posts_list" do %>
  <%= turbo_frame_tag "posts_list" do %>
    <% toggle_path = @view_mode == :full ? group_path(@group) : group_path(@group, view: "full") %>
    <% view_param = @view_mode == :full ? "full" : nil %>
    <%= render "posts/post_list",
               posts: @posts,
               view_mode: @view_mode,
               toggle_path: toggle_path,
               show_actions: false,
               show_group_badges: false,
               header_badge_label: "Shared update",
               empty_state_message: "No posts in this group yet." %>

    <%= render "shared/pagination",
               collection: @posts,
               label: "Group posts pagination",
               path_for_page: ->(page) { group_path(@group, page: page, view: view_param, format: :turbo_stream) } %>
  <% end %>
<% end %>
