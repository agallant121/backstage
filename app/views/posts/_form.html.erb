<%= form_with model: @post, local: true, html: { class: "card shadow-sm" } do |f| %>
  <div class="card-body d-flex flex-column gap-3">
    <% if @post.errors.any? %>
      <div class="alert alert-danger mb-0">
        <h2 class="h6 mb-2"><%= "#{pluralize(@post.errors.count, "error")} prevented this post from saving:" %></h2>
        <ul class="mb-0 ps-3">
          <% @post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-floating">
      <%= f.text_area :body, rows: 5, class: "form-control", placeholder: "What's going on?", style: "height: 150px" %>
      <%= f.label :body, "What's going on?" %>
      <div class="form-text"><%= "Share a quick update to one group or everyone. You can also upload photos or short videos." %></div>
    </div>

    <div>
      <label class="form-label"><%= "Send to group" %></label>
      <% selected_group_ids = Array(@selected_group_ids.presence || @group&.id).map(&:to_i) %>
      <% selected_groups = @groups_for_select.select { |group| selected_group_ids.include?(group.id) } %>
      <% group_select_label = selected_groups.any? ? selected_groups.map(&:name).to_sentence : "All Groups" %>
      <div class="dropdown post-group-select" data-controller="group-select" data-group-select-all-label-value="All Groups">
        <button class="form-select text-start post-group-select__toggle"
                type="button"
                data-bs-toggle="dropdown"
                data-bs-auto-close="outside"
                aria-expanded="false"
                data-group-select-target="button">
          <%= group_select_label %>
        </button>
        <ul class="dropdown-menu w-100 post-group-select__menu">
          <li>
            <label class="dropdown-item post-group-select__item">
              <%= check_box_tag "post[group_ids][]",
                                "",
                                selected_groups.empty?,
                                class: "form-check-input mt-0",
                                data: { group_select_target: "all", action: "group-select#toggleAll" } %>
              <span><%= "All Groups" %></span>
            </label>
          </li>
          <% @groups_for_select.each do |group| %>
            <li>
              <label class="dropdown-item post-group-select__item">
                <%= check_box_tag "post[group_ids][]",
                                  group.id,
                                  selected_group_ids.include?(group.id),
                                  class: "form-check-input mt-0",
                                  data: { group_select_target: "group", action: "group-select#toggleGroup", group_name: group.name } %>
                <span><%= group.name %></span>
              </label>
            </li>
          <% end %>
        </ul>
      </div>
      <div class="form-text"><%= "Choose any groups or keep All Groups selected to send to every group." %></div>
    </div>

    <div>
      <label class="form-label"><%= "Attach media" %></label>
      <%= f.file_field :attachments, accept: "image/*,video/*", multiple: true, class: "form-control" %>
      <div class="form-text"><%= "Add photos or short videos. Keep it light; everyone sees the update at once." %></div>
    </div>

  </div>
  <div class="card-footer bg-white d-flex justify-content-between">
    <%= link_to "Cancel", root_path, class: "btn btn-outline-secondary" %>
    <%= f.submit "Post", class: "btn btn-primary" %>
  </div>
<% end %>
